# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Postgres. Matches docker-compose.yml defaults.
DATABASE_URL=postgres://ledger:ledger@localhost:5432/ledger

# Separate database used by the integration suite. It is dropped and
# recreated on every run, so never point this at anything you care about.
TEST_DATABASE_URL=postgres://ledger:ledger@localhost:5432/ledger_test

# JWT signing secrets. Generate with:  openssl rand -hex 32
# These example values are placeholders and MUST be replaced in any real deployment.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0000000000000000
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-000000000000000

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Rate limiting on auth endpoints only (see scope).
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
